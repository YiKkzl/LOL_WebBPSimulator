# Local-only development values. Do not put production secrets in this file.

# Prisma and Docker MySQL from docker-compose.yml
DATABASE_URL="mysql://lolbp:lolbp_dev_password@127.0.0.1:3307/lolbp_test"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3307"
MYSQL_DATABASE="lolbp_test"
MYSQL_USER="lolbp"
MYSQL_PASSWORD="lolbp_dev_password"

# Optional read-only account for MySQL MCP schema inspection
MYSQL_MCP_HOST="127.0.0.1"
MYSQL_MCP_PORT="3307"
MYSQL_MCP_DATABASE="lolbp_test"
MYSQL_MCP_USER="lolbp_ro"
MYSQL_MCP_PASSWORD="lolbp_readonly_password"

# Next.js defaults for the future migration phase
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
LEGACY_API_PATH="/api.php"
